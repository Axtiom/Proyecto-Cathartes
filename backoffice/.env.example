DB_HOST=127.0.0.1
DB_NAME=cathartes
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
# Mismo APP_TOKEN_SECRET que api-usuarios: el backoffice valida su cookie de sesión.
APP_TOKEN_SECRET=
APP_TOKEN_TTL=7776000
COOKIE_SECURE=false
# Solo dev: con true, un error no capturado muestra el detalle en pantalla.
# En el servidor va SIEMPRE en false (el detalle se loguea, no se muestra).
APP_DEBUG=false
LOGIN_URL=http://localhost/sigeru/frontend-usuarios/login.html
FRONTEND_URL=http://localhost/sigeru/frontend-usuarios

# Storage de fotos de incidencias (las escribe api-gestion)
INCIDENCIAS_UPLOADS_DIR=D:/sigeru/api-gestion/storage/uploads/incidencias
