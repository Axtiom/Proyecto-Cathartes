DB_HOST=127.0.0.1
DB_NAME=cathartes
DB_USER=cathartes_app
DB_PASS=cambiar_esta_clave
DB_CHARSET=utf8mb4

# Debe ser IDÉNTICO en las 4 apps (api-usuarios, api-gestion, api-recoleccion,
# backoffice): todas comparten la misma cookie de sesión firmada.
APP_TOKEN_SECRET=
APP_TOKEN_TTL=7776000        # 90 días (Recordarme)
COOKIE_SECURE=false          # true en producción (HTTPS); false en dev (HTTP)

# Solo dev: con true, un error no capturado muestra el detalle en pantalla.
# En el servidor va SIEMPRE en false (el detalle se loguea, no se muestra).
APP_DEBUG=false

# Opcional: solo hace falta si frontend-usuarios vive en otro host/carpeta
# distinto al de al lado de esta app. Por default se calcula solo (relativo).
# LOGIN_URL=http://localhost/cathartes/frontend-usuarios/login.html

# Storage de fotos de incidencias, COMPARTIDO con api-gestion (que las
# escribe). Opcional: por default usa storage/uploads/ en la raíz del repo,
# hermana de esta app (ruta relativa, no absoluta).
# INCIDENCIAS_UPLOADS_DIR=
