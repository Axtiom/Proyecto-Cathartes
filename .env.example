# Variables para docker compose. Copiar a `.env` (que NO se sube a Git) y cambiar los valores.
DB_ROOT_PASSWORD=cambiar_clave_root
DB_NAME=cathartes
DB_USER=cathartes_app
DB_PASS=cambiar_clave_app
# Generar uno largo y aleatorio:  openssl rand -hex 32
APP_TOKEN_SECRET=
COOKIE_SECURE=false          # true detrás de HTTPS
WEB_PORT=8080
MAIL_DRIVER=stub
