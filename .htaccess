# Habilitar RewriteEngine e Indexación de Directorios para Desarrollo Local
Options +Indexes +FollowSymLinks
RewriteEngine On

# Configuración Global de Encabezados CORS
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# Permitir acceso total a todos los recursos
DirectoryIndex index.html index.php

# Garantizar que las subcarpetas sean accesibles directamente
<Directory />
    AllowOverride All
    Require all granted
</Directory>