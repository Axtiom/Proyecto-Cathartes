DB_HOST=127.0.0.1
DB_NAME=cathartes
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Debe ser IDÉNTICO en las 4 apps (api-usuarios, api-gestion, api-recoleccion,
# backoffice): esta app EMITE la cookie de sesión que las otras tres validan.
APP_TOKEN_SECRET=
APP_TOKEN_TTL=7776000        # 90 días (Recordarme)
COOKIE_SECURE=false          # true en producción (HTTPS); false en dev (HTTP)

# Solo dev: con true, un error no capturado muestra el detalle en el JSON.
# En el servidor va SIEMPRE en false (el detalle se loguea, no se muestra).
APP_DEBUG=false

# Opcional: solo hace falta si frontend-usuarios vive en otro host/carpeta
# distinto al de al lado de esta app. Por default se calcula solo (relativo).
# LOGIN_URL=http://localhost/cathartes/frontend-usuarios/login.html

MAIL_DRIVER=stub             # stub | smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
